{
  "name": "gamelog",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsx scripts/check-build.ts && tsx scripts/check-desktop.ts",
    "build:desktop": "npm run build && electron-builder --win",
    "lint": "oxlint src server electron tests scripts vite.config.ts playwright.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "build:web": "npm run typecheck && tsx scripts/build-web.ts && tsx scripts/check-build.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:ui": "playwright test",
    "test:ui:production": "npm run build:web && tsx scripts/test-ui-production.ts",
    "test:desktop": "tsx scripts/test-desktop.ts",
    "check:publication": "tsx scripts/public-source.ts",
    "export:github": "tsx scripts/public-source.ts --export",
    "screenshots": "npm run build:web && tsx scripts/capture-portfolio.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.69.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.gamelog.app",
    "productName": "Gamelog",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!dist/.vite/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.svg",
      "artifactName": "Gamelog-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "description": "A personal game library, play journal and discovery app.",
  "overrides": {
    "minimatch@>=7 <11": "^11.0.5"
  }
}
